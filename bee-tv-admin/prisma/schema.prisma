generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  nickname  String   @default("")
  avatar    String   @default("")
  role      String   @default("admin")
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  group     String   @default("basic")
  remark    String   @default("")
  updatedAt DateTime @updatedAt
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int      @default(0)
  admin     String   @default("")
  action    String
  module    String   @default("")
  method    String   @default("")
  path      String   @default("")
  ip        String   @default("")
  remark    String   @default("")
  createdAt DateTime @default(now())
}

model MemberLevel {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float    @default(0)
  duration  Int      @default(30)
  status    Int      @default(1)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
  activationCodes ActivationCode[]
}

model Member {
  id         Int         @id @default(autoincrement())
  userId     String      @unique
  deviceId   String      @default("")
  levelId    Int
  level      MemberLevel @relation(fields: [levelId], references: [id])
  score      Int         @default(0)
  balance    Float       @default(0)
  status     Int         @default(1)
  expireAt   DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model SignLog {
  id             Int      @id @default(autoincrement())
  userId         String
  signDate       String
  consecutiveDays Int     @default(1)
  reward         Int      @default(0)
  createdAt      DateTime @default(now())
}

model ScoreLog {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String   @default("sign_in")
  score     Int
  balance   Int      @default(0)
  remark    String   @default("")
  createdAt DateTime @default(now())
}

model ScoreProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  image       String   @default("")
  type        Int      @default(0)
  points      Int
  value       String   @default("")
  stock       Int      @default(-1)
  status      Int      @default(1)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScoreExchange {
  id          Int      @id @default(autoincrement())
  userId      String
  productId   Int
  productName String   @default("")
  points      Int
  result      String   @default("")
  status      Int      @default(0)
  createdAt   DateTime @default(now())
}

model CompileTask {
  id            Int      @id @default(autoincrement())
  name          String   @default("")
  githubRepo    String
  githubToken   String
  workflowFile  String   @default("build.yml")
  branch        String   @default("release")
  version       String   @default("")
  versionCode   Int      @default(0)
  channel       String   @default("all")
  status        String   @default("pending")
  workflowRunId String   @default("")
  artifactUrl   String   @default("")
  artifacts     String   @default("")
  log           String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ActivationCode {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  levelId   Int
  level     MemberLevel  @relation(fields: [levelId], references: [id])
  status    Int          @default(0)
  usedBy    String       @default("")
  usedAt    DateTime?
  createdAt DateTime     @default(now())
}

model PaymentConfig {
  id        Int      @id @default(autoincrement())
  channel   String   @unique
  config    String
  status    Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PaymentOrder {
  id          Int      @id @default(autoincrement())
  orderNo     String   @unique
  tradeNo     String   @default("")
  userId      String
  levelId     Int
  amount      Float
  channel     String
  payType     String   @default("alipay")
  status      Int      @default(0)
  createdAt   DateTime @default(now())
  paidAt      DateTime?
}

model EpayConfig {
  id        Int      @id @default(autoincrement())
  name      String   @default("默认")
  pid       String
  key       String
  apiUrl    String   @default("https://epay.example.com/submit.php")
  notifyUrl String   @default("")
  returnUrl String   @default("")
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hotsearch {
  id        Int      @id @default(autoincrement())
  title     String
  url       String   @default("")
  sort      Int      @default(0)
  status    Int      @default(1)
  appIds    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  type      Int      @default(1)
  status    Int      @default(1)
  appIds    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiEndpoint {
  id             Int      @id @default(autoincrement())
  name           String
  // 0=点播，1=直播，2=壁纸，3=播放解析
  type           Int
  url            String
  remark         String   @default("")
  minMemberLevel Int      @default(0)
  priority       Int      @default(0)
  isDefault      Boolean  @default(false)
  status         Int      @default(1)
  appIds         String   @default("")
  ext            String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, status, minMemberLevel, isDefault, priority])
}

model RepoSource {
  id             Int      @id @default(autoincrement())
  name           String
  url            String   @unique
  type           Int
  priority       Int      @default(0)
  minMemberLevel Int      @default(0)
  isDefault      Boolean  @default(false)
  status         Int      @default(1)
  appIds         String   @default("")
  encrypted      Boolean  @default(false)
  weight         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, minMemberLevel, isDefault, priority])
}

model HomeLayout {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("mobile")
  page      String   @default("home")
  template  String   @default("classic")
  config    String
  status    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, page, status, updatedAt])
}

model AppVersion {
  id          Int      @id @default(autoincrement())
  versionName String
  versionCode Int
  channel     String   @default("default")
  appId       String   @default("")
  downloadUrl String
  changelog   String   @default("")
  packageSize String   @default("")
  forceUpdate Int      @default(0)
  status      Int      @default(1)
  createdAt   DateTime @default(now())
}

model AppChannel {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  packageId String   @default("")
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// FongMi/TVBox client application identity and runtime policy.
model ClientApp {
  id            Int      @id @default(autoincrement())
  name          String
  appId         String   @unique
  appKey        String
  qqGroup       String   @default("")
  packageId     String   @default("")
  platform      String   @default("tv")
  loginLimit    Int      @default(3)
  operationMode String   @default("all_free")
  logo          String   @default("")
  splash        String   @default("")
  backdrop      String   @default("")
  playerImage   String   @default("")
  playerImageLink    String   @default("")
  playerBgImage      String   @default("")
  profileImage       String   @default("")
  profileImageLink   String   @default("")
  serviceImage       String   @default("")
  about              String   @default("")
  runtimeConfig      String   @default("")
  registerPolicy     Int      @default(-1)
  autoRegisterPolicy Int      @default(-1)
  emailPolicy        Int      @default(-1)
  status             Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AppUser {
  id        Int      @id @default(autoincrement())
  username  String   @default("")
  email     String   @unique
  password  String
  nickname  String
  phone     String   @default("")
  avatar    String   @default("")
  role      String   @default("user")
  status    Int      @default(1)
  score     Int      @default(0)
  balance   Float    @default(0)
  memberLevel Int    @default(0)
  memberExpireAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
  comments  PostComment[]
  likes     PostLike[]
  favorites PostFavorite[]
  sessions  ClientSession[]
}

// Device-bound login records for FongMi/TVBox and mobile clients.
model ClientSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId     String   @default("default")
  deviceId  String   @default("")
  tokenId   String   @unique
  expireAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, appId, deviceId])
  @@index([userId, appId, createdAt])
}

model Post {
  id        Int      @id @default(autoincrement())
  userId    Int
  author    AppUser  @relation(fields: [userId], references: [id])
  text      String   @default("")
  images    String   @default("")
  audio     String   @default("")
  video     String   @default("")
  topic     String   @default("")
  status    Int      @default(1)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  PostComment[]
  likes     PostLike[]
  favorites PostFavorite[]
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  userId    Int
  author    AppUser  @relation(fields: [userId], references: [id])
  content   String
  status    Int      @default(1)
  createdAt DateTime @default(now())
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  userId    Int
  user      AppUser  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostFavorite {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  userId    Int
  user      AppUser  @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model UserHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  vodId     String
  vodName   String
  vodPic    String   @default("")
  remark    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  vodId     String
  vodName   String
  vodPic    String   @default("")
  type      String   @default("")
  remark    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, vodId])
}

model AppSignLog {
  id             Int      @id @default(autoincrement())
  userId         Int
  signDate       String
  consecutiveDays Int     @default(1)
  reward         Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, signDate])
}

model AppScoreLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @default("sign_in")
  score     Int
  balance   Int      @default(0)
  remark    String   @default("")
  createdAt DateTime @default(now())
}

// ==================== Phase 2: 广告与弹幕管理 ====================

model Advertisement {
  id        Int       @id @default(autoincrement())
  title     String
  image     String
  link      String    @default("")
  params    String    @default("")
  position  String    @default("mobile_home")
  appIds    String    @default("")
  sort      Int       @default(0)
  status    Int       @default(1)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Marquee {
  id        Int      @id @default(autoincrement())
  content   String
  color     String   @default("#FFFFFF")
  bgColor   String   @default("#000000")
  speed     Int      @default(50)
  position  String   @default("top")
  appIds    String   @default("")
  sort      Int      @default(0)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DanmakuConfig {
  id             Int      @id @default(autoincrement())
  name           String
  apiUrl         String
  method         String   @default("GET")
  headers        String   @default("")
  params         String   @default("")
  urlKeywords    String   @default("")
  keywordMode    String   @default("include")
  appIds         String   @default("")
  status         Int      @default(1)
  sort           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==================== Phase 3: 会员管理增强 ====================

model MemberGroup {
  id                  Int      @id @default(autoincrement())
  name                String
  levelId             Int      @default(0)
  price               Float    @default(0)
  duration            Int      @default(30)
  isPermanent         Boolean  @default(false)
  description         String   @default("")
  discount            Float    @default(1.0)
  dailyScore          Int      @default(0)
  deviceLimit         Int      @default(0)
  loginOverflowAction String   @default("auto_kick")
  level               Int      @default(0)
  status              Int      @default(1)
  sort                Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MemberRule {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("play_quality")
  value     String   @default("")
  levelId   Int      @default(0)
  status    Int      @default(1)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BalanceLog {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String   @default("recharge")
  amount    Float
  balance   Float    @default(0)
  remark    String   @default("")
  orderId   String   @default("")
  createdAt DateTime @default(now())
}

// ==================== Phase 6: 多仓管增强 ====================

model RepoScript {
  id        Int      @id @default(autoincrement())
  repoId    Int      @default(0)
  name      String
  type      String   @default("js")
  content   String   @default("")
  status    Int      @default(1)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Phase 7: APP配置下发 ====================

model AppConfig {
  id        Int      @id @default(autoincrement())
  appId     String
  config    String   @default("")
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId])
}

// ==================== Phase 8: 附件管理 ====================

model Attachment {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  size      Int      @default(0)
  type      String   @default("image")
  module    String   @default("")
  uploader  String   @default("")
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Phase 9: 充值管理 ====================

model RechargeOrder {
  id            Int      @id @default(autoincrement())
  userId        String   @default("")
  orderId       String   @default("")
  orderAmount   Float    @default(0)
  allocateAmount Float   @default(0)
  payAmount     Float    @default(0)
  payType       String   @default("")
  payTime       DateTime?
  ip            String   @default("")
  remark        String   @default("")
  status        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== Phase 10: 设备数量管理 ====================

model DeviceLimit {
  id        Int      @id @default(autoincrement())
  name      String
  count     Int      @default(1)
  remark    String   @default("")
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
